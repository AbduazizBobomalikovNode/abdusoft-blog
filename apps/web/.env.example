NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=abdusoft

# Ixtiyoriy — footer/RSS uchun havolalar
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=

# apps/api dagi REVALIDATE_SECRET bilan bir xil bo'lishi kerak
REVALIDATE_SECRET=

# Cloudflare Turnstile — bo'sh bo'lsa izoh formasida widget ko'rsatilmaydi
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 1 bo'lsa, izoh formasida "GitHub bilan kirish" tugmasi ko'rsatiladi
# (apps/api'da GITHUB_CLIENT_ID/SECRET sozlangan bo'lishi kerak)
NEXT_PUBLIC_GITHUB_LOGIN=

# Umami analytics script — ikkalasi ham bo'lsa (site) layout'ga <Script> qo'shiladi.
# /admin'da hech qachon yuklanmaydi.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
