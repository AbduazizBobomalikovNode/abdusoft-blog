# Ishlab chiqarish (Vercel) uchun to'liq env namunasi.
# Vercel loyiha sozlamalarida (Settings -> Environment Variables, "Production"
# muhiti uchun) shu qiymatlarni kiriting. Root Directory: apps/web.

# apps/api VDS'da qaysi domenda turadi.
NEXT_PUBLIC_API_URL=https://api.abdusoft.uz
# Bu frontend'ning o'zi qaysi domenda (sitemap, RSS, OG rasmlar shundan tuziladi).
NEXT_PUBLIC_SITE_URL=https://blog.abdusoft.uz
NEXT_PUBLIC_SITE_NAME=abdusoft

# Ixtiyoriy — footer/RSS uchun havolalar.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_GITHUB_URL=

# apps/api dagi REVALIDATE_SECRET bilan AYNI BIR XIL bo'lishi shart — API post
# chop etilganda/o'zgarganda shu secret bilan /api/revalidate'ni chaqiradi.
REVALIDATE_SECRET=

# Cloudflare Turnstile site key (public, secret emas) — bo'sh bo'lsa izoh
# formasida widget ko'rsatilmaydi. apps/api'dagi TURNSTILE_SECRET_KEY bilan
# bir juftlik (https://dash.cloudflare.com/?to=/:account/turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 1 bo'lsa, izoh formasida "GitHub bilan kirish" tugmasi ko'rsatiladi
# (apps/api'da GITHUB_CLIENT_ID/SECRET sozlangan bo'lishi kerak).
NEXT_PUBLIC_GITHUB_LOGIN=1

# Umami analytics script — ikkalasi ham to'ldirilsa (site) layout'ga <Script>
# qo'shiladi. /admin'da hech qachon yuklanmaydi. Umami'ni birinchi ochganda
# "Add website" orqali sayt qo'shing va Website ID'ni shu yerga qo'ying.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.abdusoft.uz/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
