# Ishlab chiqarish (VDS + Coolify) uchun to'liq env namunasi.
# Coolify'da bu qiymatlarni loyihaning "Environment Variables" bo'limiga kiriting
# (fayl sifatida saqlash shart emas — Coolify build vaqtida .env yaratadi).

NODE_ENV=production
PORT=4000

# Ushbu API'ning o'zi qaysi domenda turadi (webhook/callback URL'lar shundan tuziladi).
API_ORIGIN=https://api.abdusoft.uz
# Frontend (Vercel) qaysi domenda — CORS shu qiymatga ruxsat beradi.
WEB_ORIGIN=https://blog.abdusoft.uz
# Ikkala subdomen ustidan umumiy cookie — boshida nuqta shart (`.abdusoft.uz`),
# aks holda auth cookie faqat bitta subdomenga tegishli bo'lib qoladi.
COOKIE_DOMAIN=.abdusoft.uz

# docker-compose.yml'dagi `api` xizmati shu Postgres'ga shu tarzda ulanadi
# (host nomi `postgres` — compose network ichidagi xizmat nomi).
DATABASE_URL=postgres://blog:CHANGE_ME_STRONG_PASSWORD@postgres:5432/blog
# Yuqoridagi parol bilan bir xil bo'lishi kerak — docker-compose.yml postgres
# konteynerini shu qiymat bilan ishga tushiradi.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Better Auth session/cookie imzolash kaliti — SHART, tasodifiy va maxfiy.
# Yaratish: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Ixtiyoriy — bo'sh qoldirilsa qurilma cookie'sini imzolash uchun
# BETTER_AUTH_SECRET ishlatiladi. Xohlasangiz alohida qiymat bering.
DEVICE_SECRET=

# Birinchi marta ishga tushganda shu email/parol bilan admin foydalanuvchi
# yaratiladi (`node dist/scripts/seed.js` orqali, README'dagi "Birinchi admin"
# bo'limiga qarang). Deploy'dan keyin parolni albatta o'zgartiring.
ADMIN_EMAIL=admin@abdusoft.uz
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- GitHub OAuth (kirish uchun) -------------------------------------------
# GitHub'da yaratish: https://github.com/settings/developers -> "New OAuth App"
# Homepage URL: https://blog.abdusoft.uz
# Authorization callback URL: https://api.abdusoft.uz/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Cloudflare R2 (rasm/media saqlash) -------------------------------------
# Bo'sh qoldirilsa API mahalliy diskka (.data/uploads, docker-compose'da named
# volume bilan himoyalangan) saqlaydi — lekin ko'p nusxali/qayta deploy
# muhitida R2 tavsiya etiladi (fayllar konteyner qayta yaratilganda yo'qolmaydi).
# R2 bucket yaratish: Cloudflare Dashboard -> R2 -> Create bucket, so'ng
# "Public access" yoqib bucket uchun public domen oling (yoki custom domen ulang).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Telegram bot ------------------------------------------------------------
# BotFather (@BotFather) orqali bot yarating, tokenni shu yerga qo'ying.
TELEGRAM_BOT_TOKEN=
# SHART (TELEGRAM_BOT_TOKEN sozlangan bo'lsa) — kamida 16 belgi, aks holda
# server ishga tushmaydi. grammY webhook so'rovlarini shu qiymat bilan
# tasdiqlaydi (X-Telegram-Bot-Api-Secret-Token header) — bo'lmasa istalgan
# kishi soxta admin buyruqlari yubora oladi. Yaratish: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Izoh bildirishnomalari va /stats, /pending kabi buyruqlar shu chatga yuboriladi.
# Olish yo'llari: (1) botni admin sifatida guruhga qo'shib @getidsbot'ga forward
# qiling, (2) shaxsiy chat uchun @userinfobot'ga /start yozing, (3) yoki
# botga xabar yuborib https://api.telegram.org/bot<TOKEN>/getUpdates orqali
# javobdagi chat.id'ni o'qing.
TELEGRAM_ADMIN_CHAT_ID=
# Vergul bilan ajratilgan Telegram user id'lar — faqat shular bot buyruqlarini
# ishlata oladi (id olish yo'llari yuqoridagi bilan bir xil).
TELEGRAM_ADMIN_USER_IDS=
# @kanalnomi (bot kanalga admin sifatida qo'shilgan bo'lishi kerak) yoki
# raqamli chat id — chop etilgan postlar shu kanalga yuboriladi.
TELEGRAM_CHANNEL_ID=
TELEGRAM_API_ROOT=https://api.telegram.org

# --- Telegraph (post ko'zgulash) ---------------------------------------------
# Bo'sh qoldirilsa birinchi mirrorlashda avtomatik yaratiladi va bazaga saqlanadi.
TELEGRAPH_ACCESS_TOKEN=
TELEGRAPH_API_ROOT=https://api.telegra.ph
# Prod'da yoqing — Telegraph ko'zgulash shu bayroq true bo'lgandagina ishlaydi.
TELEGRAPH_ENABLED=true

# --- Cloudflare Turnstile (spam-bot himoyasi) --------------------------------
# https://dash.cloudflare.com/?to=/:account/turnstile -> Add site
TURNSTILE_SECRET_KEY=
# true — TURNSTILE_SECRET_KEY bo'sh bo'lsa izoh yuborish rad etiladi
# (fail-closed). Prod'da TURNSTILE_SECRET_KEY to'ldirilgan bo'lsa bu bayroq
# amalda ta'sir qilmaydi — faqat sozlashni unutgan holatlar uchun xavfsizlik to'ri.
REQUIRE_TURNSTILE=true

# apps/web dagi REVALIDATE_SECRET bilan AYNI BIR XIL bo'lishi shart.
# Yaratish: openssl rand -hex 32
REVALIDATE_SECRET=

# --- Umami analytics ----------------------------------------------------------
# Umami birinchi marta ochilganda (https://analytics.abdusoft.uz yoki
# to'g'ridan-to'g'ri portdan) admin/umami bilan kiring, parolni darhol
# o'zgartiring, "Add website" orqali sayt qo'shing va Website ID'ni oling.
UMAMI_WEBSITE_ID=
# Web'dagi <script> manbasi — odatda https://analytics.abdusoft.uz/script.js
UMAMI_SCRIPT_URL=
# docker-compose'dagi umami xizmati network ichida shu nom bilan ko'rinadi.
UMAMI_API_URL=http://umami:3000
# Umami Cloud ishlatsangiz UMAMI_API_KEY, o'z serveringiz (compose'dagi kabi)
# bo'lsa UMAMI_USERNAME + UMAMI_PASSWORD orqali login qilinadi (token keshlanadi).
UMAMI_API_KEY=
UMAMI_USERNAME=admin
UMAMI_PASSWORD=

# docker-compose.yml'dagi `umami` xizmati uchun — tasodifiy uzun satr.
# Yaratish: openssl rand -hex 32
UMAMI_APP_SECRET=

# --- Reverse proxy / IP aniqlash ---------------------------------------------
# Coolify/Traefik orqasida VDS'da SHART true bo'lishi kerak — aks holda
# rate-limit/IP-ban/Turnstile uchun mijoz IP'i noto'g'ri (proksi IP'i)
# aniqlanadi. Faqat Coolify/Traefik kabi ishonchli proksi orqasida true qiling.
TRUST_PROXY=true
