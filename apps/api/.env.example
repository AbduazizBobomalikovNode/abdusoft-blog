PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=

# Bo'sh qoldirilsa PGlite (fayl asosidagi Postgres) ishlatiladi, apps/api/.data/pglite papkasida.
DATABASE_URL=

BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret

# Ixtiyoriy — bo'sh qoldirilsa qurilma cookie'sini imzolash uchun
# BETTER_AUTH_SECRET ishlatiladi.
DEVICE_SECRET=

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Bo'sh qoldirilsa Telegram integratsiyasi butunlay o'chiq hisoblanadi.
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN sozlangan bo'lsa SHART (kamida 16 belgi) — bo'lmasa server
# ishga tushmaydi. grammY webhookCallback shu qiymatni
# X-Telegram-Bot-Api-Secret-Token header bilan solishtiradi (imzosiz so'rovlarni
# rad etadi). Masalan: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Izoh bildirishnomalari va /stats, /pending kabi buyruqlar shu chatga yuboriladi (guruh yoki DM).
TELEGRAM_ADMIN_CHAT_ID=
# Vergul bilan ajratilgan Telegram user id'lar — faqat shular bot buyruqlarini ishlata oladi.
TELEGRAM_ADMIN_USER_IDS=
# @kanalnomi yoki raqamli chat id — chop etilgan postlar shu kanalga yuboriladi.
TELEGRAM_CHANNEL_ID=
# Mahalliy mock Telegram Bot API server uchun override (test uchun).
TELEGRAM_API_ROOT=https://api.telegram.org
# Bo'sh qoldirilsa birinchi mirrorlashda avtomatik yaratiladi va site_settings'ga saqlanadi.
TELEGRAPH_ACCESS_TOKEN=
# Mahalliy mock Telegraph API server uchun override (test uchun).
TELEGRAPH_API_ROOT=https://api.telegra.ph
# true/false — Telegraph ko'zgulash shu bayroq yoqilgandagina ishlaydi. Dev'da
# false qoldiring (lokal sinovlarda tashqi Telegraph API'ga urinilmasin); prod'da true qiling.
TELEGRAPH_ENABLED=false

TURNSTILE_SECRET_KEY=
# true bo'lsa, prod muhitda TURNSTILE_SECRET_KEY bo'sh bo'lganda izoh yuborish
# rad etiladi (fail-closed). false (default) — bo'sh kalit bilan tekshiruv
# o'tkazib yuboriladi (fail-open, lekin boot vaqtida ogohlantirish chiqadi).
REQUIRE_TURNSTILE=false

# apps/web dagi REVALIDATE_SECRET bilan bir xil boiishi kerak
REVALIDATE_SECRET=

UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=

# /admin/stats/umami proxy uchun — bo'sh qoldirilsa { configured: false } qaytadi.
# Umami Cloud: UMAMI_API_URL + UMAMI_API_KEY. Self-hosted: UMAMI_API_URL +
# UMAMI_USERNAME + UMAMI_PASSWORD (login orqali token olinadi, keshlanadi).
UMAMI_API_URL=
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=

# true/false — `x-forwarded-for`/`x-real-ip` header'lariga ishonish kerakmi.
# Dev'da HAR DOIM false qoldiring (aks holda mijoz IP'ni soxtalashtirib
# rate-limit/IP-ban/Turnstile'ni chetlab o'tishi mumkin). Prod'da Coolify/Traefik
# orqasida true qiling — shundagina haqiqiy mijoz IP'i to'g'ri aniqlanadi.
TRUST_PROXY=false
