      "fileName": "apps/api/src/app.ts",
      "typing": true,
      "code": "import { Hono } from \"hono\";\nimport { PostSettingsSchema } from \"@blog/shared\";\n\nconst app = new Hono();\n\napp.get(\"/health\", (c) => c.json({ ok: true }));\n\napp.post(\"/posts\", async (c) => {\n  const body = PostSettingsSchema.parse(await c.req.json());\n  return c.json(body, 201);\n});\n\nexport default app;\n",
