{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "Schema version; currently 1"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Storyboard title (metadata and file names; not drawn)"
    },
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "description": "light | dark, matching the blog's two themes"
    },
    "accent": {
      "description": "Optional accent colour as #RGB or #RRGGBB; defaults to the blog's blue-violet. Used sparingly",
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "preset": {
      "description": "Style preset: default | vivid | blueprint | neon (default = the blog's own minimal look). Every scene follows it; fonts and code colours stay the blog's",
      "type": "string",
      "enum": [
        "default",
        "vivid",
        "blueprint",
        "neon"
      ]
    },
    "siteName": {
      "default": "abdusoft",
      "description": "Wordmark shown in the corner; default 'abdusoft'",
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "format": {
      "default": "landscape",
      "description": "Only 'landscape' (1920x1080, 30 fps) is accepted for now",
      "type": "string",
      "enum": [
        "landscape"
      ]
    },
    "defaultTransition": {
      "default": "fade",
      "description": "Transition used by scenes that do not set their own",
      "type": "string",
      "enum": [
        "cut",
        "fade",
        "slide",
        "wipe",
        "push",
        "zoom"
      ]
    },
    "scenes": {
      "minItems": 1,
      "maxItems": 16,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "title"
              },
              "id": {
                "description": "Optional stable name for this scene; used in messages and still file names",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "durationSeconds": {
                "description": "Omit for an automatic duration derived from the content (reading and typing speed). Set only to hold a scene longer; it can never be shorter than the content needs (1-30 s)",
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "transition": {
                "description": "How this scene comes in from the previous one; defaults to the storyboard's defaultTransition. Ignored on the first scene",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe",
                  "push",
                  "zoom"
                ]
              },
              "kicker": {
                "description": "Small label above the title, max 32 chars",
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Main title, max 80 chars"
              },
              "subtitle": {
                "description": "One supporting sentence, max 120 chars",
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "tags": {
                "description": "Up to 5 short pills, each max 24 chars",
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              },
              "layout": {
                "description": "left (default) | centered | split (accent panel with the kicker on the left, title on the right)",
                "type": "string",
                "enum": [
                  "left",
                  "centered",
                  "split"
                ]
              }
            },
            "required": [
              "type",
              "title"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "bullets"
              },
              "id": {
                "description": "Optional stable name for this scene; used in messages and still file names",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "durationSeconds": {
                "description": "Omit for an automatic duration derived from the content (reading and typing speed). Set only to hold a scene longer; it can never be shorter than the content needs (1-30 s)",
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "transition": {
                "description": "How this scene comes in from the previous one; defaults to the storyboard's defaultTransition. Ignored on the first scene",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe",
                  "push",
                  "zoom"
                ]
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Heading above the list, max 60 chars"
              },
              "items": {
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": "1-6 bullets revealed one by one, each max 80 chars"
              },
              "layout": {
                "description": "list (default) | centered (heading above a centred column) | split (heading on an accent panel, bullets on the right)",
                "type": "string",
                "enum": [
                  "list",
                  "centered",
                  "split"
                ]
              }
            },
            "required": [
              "type",
              "heading",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "code"
              },
              "id": {
                "description": "Optional stable name for this scene; used in messages and still file names",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "durationSeconds": {
                "description": "Omit for an automatic duration derived from the content (reading and typing speed). Set only to hold a scene longer; it can never be shorter than the content needs (1-30 s)",
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "transition": {
                "description": "How this scene comes in from the previous one; defaults to the storyboard's defaultTransition. Ignored on the first scene",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe",
                  "push",
                  "zoom"
                ]
              },
              "language": {
                "type": "string",
                "enum": [
                  "typescript",
                  "tsx",
                  "javascript",
                  "jsx",
                  "json",
                  "bash",
                  "python",
                  "go",
                  "rust",
                  "sql",
                  "yaml",
                  "html",
                  "css",
                  "markdown",
                  "diff",
                  "dockerfile",
                  "text"
                ],
                "description": "Syntax highlighting language"
              },
              "fileName": {
                "description": "Shown in the code block header, max 48 chars",
                "type": "string",
                "minLength": 1,
                "maxLength": 48
              },
              "code": {
                "type": "string",
                "minLength": 1,
                "description": "Source text, max 14 lines of max 72 chars; use spaces, not tabs"
              },
              "steps": {
                "description": "Up to 8 highlight steps shown in order; the rest of the code is dimmed",
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "lines": {
                      "type": "object",
                      "properties": {
                        "from": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991,
                          "description": "First highlighted line (1-based)"
                        },
                        "to": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991,
                          "description": "Last highlighted line (1-based, inclusive)"
                        }
                      },
                      "required": [
                        "from",
                        "to"
                      ],
                      "additionalProperties": false,
                      "description": "Inclusive 1-based line range to highlight"
                    },
                    "label": {
                      "description": "Caption shown under the code while this step is active, max 80 chars",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "durationSeconds": {
                      "description": "Omit for automatic timing based on label length and number of lines",
                      "type": "number",
                      "minimum": 1,
                      "maximum": 10
                    }
                  },
                  "required": [
                    "lines"
                  ],
                  "additionalProperties": false
                }
              },
              "typing": {
                "description": "Type the code out with a caret (default false: the block fades in complete)",
                "type": "boolean"
              }
            },
            "required": [
              "type",
              "language",
              "code"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "terminal"
              },
              "id": {
                "description": "Optional stable name for this scene; used in messages and still file names",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "durationSeconds": {
                "description": "Omit for an automatic duration derived from the content (reading and typing speed). Set only to hold a scene longer; it can never be shorter than the content needs (1-30 s)",
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "transition": {
                "description": "How this scene comes in from the previous one; defaults to the storyboard's defaultTransition. Ignored on the first scene",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe",
                  "push",
                  "zoom"
                ]
              },
              "title": {
                "description": "Window title, max 32 chars",
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "lines": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "command"
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 72,
                          "description": "Typed after the prompt, max 72 chars"
                        },
                        "waitSeconds": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 5,
                          "description": "Pause before typing, 0-5 s"
                        }
                      },
                      "required": [
                        "kind",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "output"
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 72,
                          "description": "One output line, max 72 chars (may be empty for a blank line)"
                        },
                        "tone": {
                          "description": "default | muted | success | error",
                          "type": "string",
                          "enum": [
                            "default",
                            "muted",
                            "success",
                            "error"
                          ]
                        },
                        "waitSeconds": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 5,
                          "description": "Pause before the line appears, 0-5 s"
                        }
                      },
                      "required": [
                        "kind",
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "description": "Commands are typed, outputs appear; at most 12 entries in total"
              }
            },
            "required": [
              "type",
              "lines"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "outro"
              },
              "id": {
                "description": "Optional stable name for this scene; used in messages and still file names",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "durationSeconds": {
                "description": "Omit for an automatic duration derived from the content (reading and typing speed). Set only to hold a scene longer; it can never be shorter than the content needs (1-30 s)",
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "transition": {
                "description": "How this scene comes in from the previous one; defaults to the storyboard's defaultTransition. Ignored on the first scene",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe",
                  "push",
                  "zoom"
                ]
              },
              "siteName": {
                "description": "Defaults to the storyboard's siteName",
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "cta": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Call to action, max 60 chars"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "description": "URL shown as text (never fetched or linked), max 48 chars"
              }
            },
            "required": [
              "type",
              "cta",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "intro"
              },
              "id": {
                "description": "Optional stable name for this scene; used in messages and still file names",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "durationSeconds": {
                "description": "Omit for an automatic duration derived from the content (reading and typing speed). Set only to hold a scene longer; it can never be shorter than the content needs (1-30 s)",
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "transition": {
                "description": "How this scene comes in from the previous one; defaults to the storyboard's defaultTransition. Ignored on the first scene",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe",
                  "push",
                  "zoom"
                ]
              },
              "variant": {
                "description": "Look of the opener: aurora | blueprint | constellation | boot | signal | slam (default aurora)",
                "type": "string",
                "enum": [
                  "aurora",
                  "blueprint",
                  "constellation",
                  "boot",
                  "signal",
                  "slam"
                ]
              },
              "kicker": {
                "description": "Small label above the title, max 32 chars",
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Main title, max 80 chars"
              },
              "subtitle": {
                "description": "One supporting sentence, max 120 chars",
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "tags": {
                "description": "Up to 5 short pills, each max 24 chars",
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              }
            },
            "required": [
              "type",
              "title"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "closing"
              },
              "id": {
                "description": "Optional stable name for this scene; used in messages and still file names",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "durationSeconds": {
                "description": "Omit for an automatic duration derived from the content (reading and typing speed). Set only to hold a scene longer; it can never be shorter than the content needs (1-30 s)",
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "transition": {
                "description": "How this scene comes in from the previous one; defaults to the storyboard's defaultTransition. Ignored on the first scene",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe",
                  "push",
                  "zoom"
                ]
              },
              "variant": {
                "description": "Look of the closer: aurora | blueprint | constellation | boot | signal | slam (default aurora)",
                "type": "string",
                "enum": [
                  "aurora",
                  "blueprint",
                  "constellation",
                  "boot",
                  "signal",
                  "slam"
                ]
              },
              "siteName": {
                "description": "Defaults to the storyboard's siteName",
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "cta": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Call to action, max 60 chars"
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48,
                "description": "URL shown as text (never fetched or linked), max 48 chars"
              }
            },
            "required": [
              "type",
              "cta",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "diagram"
              },
              "id": {
                "description": "Optional stable name for this scene; used in messages and still file names",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "durationSeconds": {
                "description": "Omit for an automatic duration derived from the content (reading and typing speed). Set only to hold a scene longer; it can never be shorter than the content needs (1-30 s)",
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "transition": {
                "description": "How this scene comes in from the previous one; defaults to the storyboard's defaultTransition. Ignored on the first scene",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe",
                  "push",
                  "zoom"
                ]
              },
              "heading": {
                "description": "Heading above the diagram, max 60 chars",
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "direction": {
                "description": "lr = left to right (default), tb = top to bottom",
                "type": "string",
                "enum": [
                  "lr",
                  "tb"
                ]
              },
              "nodes": {
                "minItems": 2,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,23}$",
                      "description": "Unique node id used by edges and steps"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 24,
                      "description": "Node title, max 24 chars"
                    },
                    "detail": {
                      "description": "Second line under the label, max 40 chars",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "tone": {
                      "description": "default | accent | muted | success | error",
                      "type": "string",
                      "enum": [
                        "default",
                        "accent",
                        "muted",
                        "success",
                        "error"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": false
                },
                "description": "2-8 nodes; placed automatically"
              },
              "edges": {
                "minItems": 1,
                "maxItems": 12,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,23}$",
                      "description": "Source node id"
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,23}$",
                      "description": "Target node id"
                    },
                    "label": {
                      "description": "Short label on the arrow, max 20 chars",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20
                    }
                  },
                  "required": [
                    "from",
                    "to"
                  ],
                  "additionalProperties": false
                },
                "description": "1-12 arrows, drawn in the order given"
              },
              "steps": {
                "description": "Up to 6 highlight steps shown in order",
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "nodes": {
                      "minItems": 1,
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9_-]{0,23}$"
                      },
                      "description": "Node ids highlighted in this step; edges between highlighted nodes light up too"
                    },
                    "label": {
                      "description": "Caption while this step is active, max 60 chars",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "durationSeconds": {
                      "description": "Omit for automatic timing",
                      "type": "number",
                      "minimum": 1,
                      "maximum": 10
                    }
                  },
                  "required": [
                    "nodes"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "nodes",
              "edges"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "compare"
              },
              "id": {
                "description": "Optional stable name for this scene; used in messages and still file names",
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
              },
              "durationSeconds": {
                "description": "Omit for an automatic duration derived from the content (reading and typing speed). Set only to hold a scene longer; it can never be shorter than the content needs (1-30 s)",
                "type": "number",
                "minimum": 1,
                "maximum": 30
              },
              "transition": {
                "description": "How this scene comes in from the previous one; defaults to the storyboard's defaultTransition. Ignored on the first scene",
                "type": "string",
                "enum": [
                  "cut",
                  "fade",
                  "slide",
                  "wipe",
                  "push",
                  "zoom"
                ]
              },
              "heading": {
                "description": "Heading above the columns, max 60 chars",
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "mode": {
                "description": "versus (A vs B, default) | beforeAfter (left becomes right)",
                "type": "string",
                "enum": [
                  "versus",
                  "beforeAfter"
                ]
              },
              "left": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 28,
                    "description": "Column title, max 28 chars"
                  },
                  "items": {
                    "minItems": 1,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "description": "1-5 short points, each max 60 chars"
                  }
                },
                "required": [
                  "title",
                  "items"
                ],
                "additionalProperties": false,
                "description": "Left column (A / before)"
              },
              "right": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 28,
                    "description": "Column title, max 28 chars"
                  },
                  "items": {
                    "minItems": 1,
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    },
                    "description": "1-5 short points, each max 60 chars"
                  }
                },
                "required": [
                  "title",
                  "items"
                ],
                "additionalProperties": false,
                "description": "Right column (B / after); drawn with the accent"
              },
              "verdict": {
                "description": "One-line conclusion shown last, max 90 chars",
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              }
            },
