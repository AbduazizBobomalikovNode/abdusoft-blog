# `pnpm deploy` (Dockerfile'da @blog/api uchun mustaqil papka yig'ish uchun
# ishlatiladi) pnpm v10'da shu sozlama bilan workspace paketlarini (masalan
# @blog/shared) symlink emas, haqiqiy fayl sifatida joylashtiradi — shundagina
# natija papka o'z-o'zidan yetarli (self-contained) bo'ladi.
inject-workspace-packages=true
